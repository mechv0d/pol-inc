ENVIRONMENT=dev
LOG_LEVEL=INFO

# Telegram bot
BOT_TOKEN=1234567890:YOUR_BOT_TOKEN_HERE

# Публичный адрес сервиса, например, адрес приложения на Render
TELEGRAM_WEBHOOK_BASE_URL=https://your-app-name.onrender.com

# Путь, куда Telegram будет присылать апдейты
TELEGRAM_WEBHOOK_PATH=/telegram/webhook

# Секрет, который бот будет проверять в заголовке X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=change_me_to_long_random_string

# Если хочется временно не регистрировать webhook, можно поставить false
TELEGRAM_WEBHOOK_ENABLED=true

# ID администраторов в формате JSON-массива
TELEGRAM_ADMIN_IDS=[123456, 789012]

# Supabase
SUPABASE_URL=https://jrjjjxxxymtkbwujmjje.supabase.co

# Серверный ключ. Никогда не светить в клиентском коде.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Бакеты в Supabase Storage
PACKS_BUCKET=game-packs
PACKS_INDEX_OBJECT=index.json
IMAGES_BUCKET=pack-images
PARTY_BUCKET=parties

# Игровые лимиты
SESSION_TTL_HOURS=4
MAX_PLAYERS=4
MIN_PLAYERS=2

# Имя стандартного игрового пака
DEFAULT_PACK_ID=base